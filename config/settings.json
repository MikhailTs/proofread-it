{
  "schema_version": 1,
  "api": {
    "model": "gpt-5.6-luna",
    "api_key_env": "OPENAI_API_KEY",
    "timeout_seconds": 30,
    "max_output_tokens": 2048,
    "retry_count": 2
  },
  "default_profile": "proofread",
  "context": {
    "fields": [
      "application_name",
      "process_name",
      "window_title"
    ],
    "exclusions": {
      "process_names": [
        "KeePass.exe"
      ],
      "window_title_words": [
        "password"
      ]
    }
  },
  "concurrency": {
    "lock_path": "../logs/proofread-it.lock"
  },
  "logging": {
    "path": "../logs/proofread-it.jsonl"
  }
}
