{
  "schema_version": 2,
  "api": {
    "model": "gpt-5.6-luna",
    "timeout_seconds": 30,
    "max_output_tokens": 2048,
    "retry_count": 2
  },
  "credential": {
    "source": "windows_credential_manager",
    "target": "ProofreadIt/OpenAIApiKey"
  },
  "default_profile": "proofread",
  "context": {
    "fields": [
      "application_name",
      "process_name",
      "window_title"
    ],
    "exclusions": {
      "process_names": [
        "KeePass.exe"
      ],
      "window_title_words": [
        "password"
      ]
    }
  },
  "concurrency": {
    "lock_path": "../logs/proofread-it.lock"
  },
  "logging": {
    "path": "../logs/proofread-it.jsonl"
  }
}
